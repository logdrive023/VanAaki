# Copie para .env (NÃO suba o .env no git). Sem ASAAS_API_KEY o serviço roda em modo simulado.
ASAAS_API_KEY=
# sandbox | producao
ASAAS_AMBIENTE=sandbox
# o mesmo token que você digitar ao cadastrar o webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
# opcional: o serviço avisa este endereço quando uma mensalidade for paga (POST com o segredo abaixo)
VANAAKI_AVISO_URL=
VANAAKI_AVISO_SEGREDO=
PORTA=8095
